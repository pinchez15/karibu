# Used by `pnpm embed-corpus` to upload PDFs to Storage and embed text
# into medical_corpus. Service role required since the script writes to
# tables RLS-locked to authenticated clinic-scoped users.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPENAI_API_KEY=sk-...

# Optional: override the corpus directory path. Defaults to the repo's
# `Medical Corpus/` folder.
# CORPUS_DIR=/absolute/path/to/Medical Corpus
