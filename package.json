{
  "name": "karibu-health",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "mobile": "pnpm --filter @karibu/mobile dev",
    "web": "pnpm --filter @karibu/web dev",
    "db:migrate": "pnpm --filter @karibu/supabase migrate",
    "db:types": "pnpm --filter @karibu/supabase generate-types",
    "android:build": "cd apps/android && ./gradlew assembleDebug",
    "android:test": "cd apps/android && ./gradlew testDebugUnitTest"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "@clerk/shared",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "sharp",
      "core-js",
      "protobufjs",
      "browser-tabs-lock"
    ]
  }
}
