# pnpm configuration
# Sentry's Next.js plugin expects @sentry/* packages hoisted to the workspace
# root so it can locate them at build time. Without this, sentry/nextjs build
# instrumentation fails to find its peers.
public-hoist-pattern[]=*sentry*

# Strict peer dep enforcement is loosened in pnpm-workspace.yaml because the
# deprecated apps/mobile workspace drifts from apps/web on react versions.
auto-install-peers=true
5