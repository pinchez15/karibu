# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-secret-key

# Clerk Authentication (production keys start with pk_live_ / sk_live_)
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk issuer URL (used by edge functions to verify Clerk session JWTs).
# Find this in Clerk Dashboard → API Keys → "Frontend API URL".
# Example: https://clerk.karibu.health  (or https://<slug>.clerk.accounts.dev for dev)
CLERK_ISSUER=https://clerk.karibu.health

# OpenAI — Whisper for clinician dictation, healthcare model for SOAP + citations.
OPENAI_API_KEY=sk-...
# Healthcare-tuned model name. Falls back to gpt-4o if unset.
OPENAI_MEDICAL_MODEL=gpt-4o

# Inngest — durable workflow orchestrator for the post-dictation pipeline
# (structure SOAP, suggest diagnoses with citations, write patient summary).
# Get these from the Inngest dashboard for this environment.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Web app URL (used in some redirect flows)
WEB_URL=https://your-app.vercel.app

# PostHog analytics
POSTHOG_KEY=phc_...
