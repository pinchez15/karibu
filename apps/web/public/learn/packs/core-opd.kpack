                "right_label": "N. BABIRYE",
                "vitals": [
                  { "label": "TEMP", "value": "38.4°", "hot": true },
                  { "label": "BP", "value": "128/82" },
                  { "label": "HR", "value": "92" },
                  { "label": "RESP", "value": "18" },
                  { "label": "SpO₂", "value": "98%" },
                  { "label": "WT", "value": "62.4" }
                ],
                "critical": {
                  "title": "Fever ≥ 38 °C with headache · suspect malaria",
                  "body": "Screen for danger signs. Re-check temp every 30 min."
                }
              }
            ]
          },
          "coach": {
            "eyebrow": "Decision · triage",
            "title": "Her vitals are in. What concerns you most?",
            "body": "The nursing assistant has captured the vitals on the tablet. Read the strip on the left before you choose."
          },
          "question": {
            "prompt": "Which single finding most changes your urgency?",
            "options": [
              { "text": "Temperature 38.4 °C with headache", "correct": true },
              { "text": "Heart rate 92 — upper-normal", "correct": false },
              { "text": "SpO₂ 98% on room air", "correct": false },
              { "text": "BP 128/82 — normal", "correct": false }
            ],
            "right": "Fever ≥ 38 °C together with headache is the combination that earns a critical flag here — it is the trigger to actively look for malaria danger signs. The HR, BP and SpO₂ are all reassuring.",
            "wrong": "Look again at the strip. HR, BP and SpO₂ are all within normal range. It is the fever (38.4 °C) paired with headache that should raise your urgency — KaribuEHR flags exactly this pair."
          }
        },
        {
          "kind": "decision",
          "chart": {
            "tag": "HISTORY",
            "sections": [
              {
                "type": "subjective",
                "title": "Subjective",
                "text": "34F · 3-day fever, headache, weakness. Paracetamol at home, little relief.",
                "reveal_text": "No vomiting/diarrhoea. Drinking. Fully alert. LMP 2 wks ago."
