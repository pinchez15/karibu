{
  "name": "karibu-health",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm --filter @karibu/design-system typecheck && pnpm --filter @karibu/clinical-ui typecheck && pnpm --filter @karibu/content-schema typecheck",
    "web": "pnpm --filter @karibu/web dev",
    "db:migrate": "pnpm --filter @karibu/supabase migrate",
    "db:types": "pnpm --filter @karibu/supabase generate-types",
    "demo:baseline": "pnpm --filter @karibu/supabase-demo baseline",
    "demo:seed": "pnpm --filter @karibu/supabase-demo seed",
    "demo:reset": "pnpm --filter @karibu/supabase-demo reset",
    "android:build": "cd apps/android && ./gradlew assembleDebug",
    "android:test": "cd apps/android && ./gradlew testDebugUnitTest",
    "learn-android:build": "cd apps/learn-android && ../android/gradlew -p . assembleDebug",
    "learn-android:test": "cd apps/learn-android && ../android/gradlew -p . testDebugUnitTest",
    "learn-android:upload": "cd apps/learn-android && ./scripts/upload-beta.sh",
    "learn:export-packs": "pnpm --filter @karibu/learn-supabase export-packs",
    "learn:sync-manifest": "pnpm --filter @karibu/learn-supabase sync-manifest",
    "learn:upload-packs": "pnpm --filter @karibu/learn-supabase upload-packs",
    "learn:publish-packs": "pnpm --filter @karibu/learn-supabase publish-packs",
    "ai:eval": "pnpm --filter @karibu/ai-evals eval"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "@clerk/shared",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "sharp",
      "core-js",
      "protobufjs",
      "browser-tabs-lock"
    ]
  }
}
