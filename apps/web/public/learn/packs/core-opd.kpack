      "mode": "Core Practice",
      "level": 1,
      "mins": 12,
      "credit": 0.25,
      "setting": "Susunga HC III · OPD",
      "patient": { "name": "Nakato Sarah", "id": "PT-100015", "age": "34F", "sex": "Female" },
      "blurb": "A young woman walks in with three days of fever, headache and body weakness. Decide what to ask, what to test, and what to treat — the way you would on a busy morning.",
      "objectives": [
        "Recognise danger signs that change a febrile presentation from routine to urgent",
        "Apply the test-before-treat rule for suspected malaria (Uganda Clinical Guidelines)",
        "Dose artemether-lumefantrine by weight, and counsel on completing the course",
        "Write a clear SOAP note and choose the correct HMIS diagnosis code"
      ],
      "skills": ["History taking", "Malaria", "Rational prescribing", "HMIS coding"],
      "takeaways": [
        "Fever ≥ 38 °C with headache earns a deliberate danger-sign screen first.",
        "Test before you treat — a positive RDT comes before antimalarials.",
        "AL at ≥ 35 kg: 4 tablets twice daily for 3 days. Finish the course.",
        "Code the confirmed diagnosis (B54), not the presenting symptom."
      ],
      "citations": [
        "Uganda Clinical Guidelines 2023",
        "MoH Uganda — Malaria management",
        "WHO Malaria treatment, 3rd ed."
      ],
      "share": {
        "share_title": "Fever and headache, 3 days — what would you do?",
        "share_prompt": "A 34-year-old woman: fever 3 days, headache, T 38.4 °C. Test or treat? Try the case on KaribuLearn.",
        "share_summary": "A test-before-treat malaria case for HC III — danger signs, RDT, weight-based AL dosing, HMIS coding.",
        "share_url": "https://learn.karibu.health/c/fever-headache",
        "evidence_card": "Uganda Clinical Guidelines 2023: parasitological confirmation (RDT or microscopy) is required before antimalarials in all ages where testing is available.",
        "discussion_question": "When is presumptive antimalarial treatment ever justified at HC III?"
      },
      "meta": {
