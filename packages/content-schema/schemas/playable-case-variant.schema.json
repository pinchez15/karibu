{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.karibu.health/learn/playable-case-variant.schema.json",
  "title": "PlayableCaseVariant",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "canonicalCaseId", "label", "difficultyLevel", "questType", "initiallyVisible", "informationReveals", "ehrTasks", "scoringRules", "scores"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "canonicalCaseId": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "difficultyLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
    "questType": { "type": "string", "enum": ["core_practice", "challenge", "case_conference"] },
    "initiallyVisible": { "type": "array", "items": { "type": "string" } },
    "informationReveals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fieldPath", "trigger", "rationale"],
        "properties": {
          "fieldPath": { "type": "string" },
          "trigger": {
            "type": "string",
            "enum": ["initial", "request_vitals", "ask_history", "record_exam", "order_test", "choose_diagnosis", "decide_referral"]
          },
          "rationale": { "type": "string" }
        }
      }
    },
    "ehrTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "taskType", "prompt", "required", "scoringWeight"],
        "properties": {
          "id": { "type": "string" },
          "taskType": {
            "type": "string",
            "enum": ["enter_vitals", "record_chief_complaint", "ask_history", "record_exam", "choose_diagnosis", "order_test", "write_plan", "decide_referral", "complete_note"]
          },
          "prompt": { "type": "string" },
          "required": { "type": "boolean" },
          "scoringWeight": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "scoringRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "points"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "points": { "type": "integer" },
          "citationIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "scores": { "$ref": "case-scores.schema.json" }
  }
}
