# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-secret-key

# Clerk Authentication (production keys start with pk_live_ / sk_live_)
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# OpenAI (for English transcription and note generation)
OPENAI_API_KEY=sk-...

# Clerk issuer URL (used by edge functions to verify Clerk session JWTs)
# Find this in Clerk Dashboard → API Keys → "Frontend API URL"
# Example: https://clerk.karibu.health  (or https://<slug>.clerk.accounts.dev for dev)
CLERK_ISSUER=https://clerk.karibu.health

# Sunbird AI (for Ugandan local language transcription and translation)
# Optional — if not set, local language transcription will be unavailable
SUNBIRD_API_KEY=

# Web App URL
WEB_URL=https://your-app.vercel.app

# PostHog Analytics
POSTHOG_KEY=phc_...
