# Next.js Environment Variables

# Clerk Authentication (production keys start with pk_live_ / sk_live_)
# Get these from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# Public (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never exposed to browser)
SUPABASE_SECRET_KEY=your-secret-key

# Superadmin bootstrap allowlist (server-only).
# When the superadmins table is empty, ONLY the clinic admin whose Clerk
# primary email matches this value may use the provisioning bootstrap path
# (which seeds the first superadmin row). Leave unset to disable bootstrap.
SUPERADMIN_BOOTSTRAP_EMAIL=

# PostHog Analytics
# Get these from https://us.posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring (optional — errors only logged to console if not set)
# Get DSN from https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
