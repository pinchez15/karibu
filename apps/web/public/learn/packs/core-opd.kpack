          "coach": {
            "eyebrow": "Decision · prescribe",
            "title": "Confirm the artemether-lumefantrine dose",
            "body": "Sarah weighs 62.4 kg. AL is dosed by weight band. Check the assistant’s suggestion before you confirm — you are responsible for it."
          },
          "question": {
            "prompt": "Which AL regimen is correct for a 62 kg adult?",
            "calculator": true,
            "options": [
              { "text": "4 tablets (80/480 mg) twice daily for 3 days", "correct": true },
              { "text": "1 tablet twice daily for 3 days", "correct": false },
              { "text": "2 tablets twice daily for 5 days", "correct": false },
              { "text": "4 tablets once daily for 3 days", "correct": false }
            ],
            "right": "For ≥ 35 kg, AL 20/120 is 4 tablets per dose, twice daily, for 3 days (24 tablets total). Counsel her to take it with fatty food and to finish every dose even when she feels better.",
            "wrong": "Check the weight band. At ≥ 35 kg the dose is 4 tablets twice daily for 3 days — a total of 24 tablets. Under-dosing risks treatment failure and resistance; the course is always 3 days, twice daily."
          }
