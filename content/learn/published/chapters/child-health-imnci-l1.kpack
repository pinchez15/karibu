    {
      "id": "child-cough-fast-breathing-001",
      "ready": true,
      "title": "Child with cough and fast breathing",
      "topic": "Child Health",
      "difficulty": "Core",
      "source_type": "Guideline Practice",
      "mode": "Core Practice",
      "level": 1,
      "mins": 7,
      "credit": 0.15,
      "setting": "HC III · OPD",
      "patient": {
        "name": "Achan Amina",
        "id": "PT-CH-240301",
        "age": "2F",
        "sex": "Female"
      },
      "blurb": "A 2-year-old with cough and fever arrives at a busy HC III. Decide whether this is routine cough, pneumonia, or referral-level danger.",
      "objectives": [
        "Use age-based respiratory rate thresholds when assessing cough and difficult breathing.",
        "Screen danger signs before deciding outpatient treatment at HC III.",
        "Classify and manage likely pneumonia using IMNCI and Uganda Clinical Guidelines 2023."
      ],
      "skills": [
        "Child Health",
        "HC III workflow",
        "Guideline application"
      ],
      "takeaways": [
        "A child aged 12-59 months with RR 48/min has fast breathing.",
        "No chest indrawing, no stridor at rest, and ability to drink support outpatient pneumonia care.",
        "Caregiver counseling on danger signs and 2-day review is essential."
      ],
      "citations": [
        "Uganda Clinical Guidelines 2023",
        "WHO IMNCI chart booklet"
      ],
      "share": {
        "share_title": "Child with cough and fast breathing",
        "share_prompt": "What would you do first for this child health presentation?",
        "share_summary": "A short HC III clinical reasoning challenge for Karibu Learn.",
        "share_url": "https://learn.karibu.health/c/child-cough-fast-breathing-001",
        "discussion_question": "Which finding most changes your next step?"
      },
      "meta": {
        "complexity_score": 0.5,
        "clinical_correctness_score": 0.89,
        "hc3_reality_score": 0.9,
        "learning_value_score": 0.86,
        "source_guideline_ids": [
          "who-imnci-chart-booklet",
          "uganda-clinical-guidelines-2023"
        ],
        "review_status": "needs_review",
        "case_version": "child-cough-fast-breathing-001-L1"
      },
      "steps": [
        {
          "kind": "story",
          "chart": {
            "tag": "TRIAGE",
            "sections": [
              {
                "type": "chiefComplaint",
                "title": "Chief complaint",
                "text": "Cough for 4 days with fever since yesterday",
                "chips": [
                  "Child",
                  "HC III OPD"
                ]
              },
              {
                "type": "subjective",
                "title": "Caregiver concern",
                "text": "Mother says breathing seems faster at night but child is still breastfeeding and drinking."
              }
            ]
          },
          "coach": {
            "eyebrow": "The visit begins",
            "title": "Amina arrives coughing and warm",
            "body": "You must decide quickly if this is severe respiratory illness or manageable pneumonia.",
            "quote": "\"She coughs all night and breathes quickly.\"",
            "teach": {
              "label": "IMNCI framing",
              "text": "In children, age and respiratory rate determine classification. Count breaths before labeling severity."
            }
          }
        },
        {
          "kind": "decision",
          "chart": {
            "tag": "VITALS",
            "sections": [
              {
                "type": "vitals",
                "title": "Initial vitals",
                "vitals": [
                  {
                    "label": "TEMP",
                    "value": "38.2 C",
                    "hot": true
                  },
                  {
                    "label": "HR",
                    "value": "118"
                  },
                  {
                    "label": "RESP",
                    "value": "48/min"
                  },
                  {
                    "label": "SpO2",
                    "value": "95%"
                  },
                  {
                    "label": "WT",
                    "value": "11.2 kg"
                  }
                ]
              },
              {
                "type": "dangerScreen",
                "title": "Danger signs screen",
                "danger_signs": [
                  "Unable to drink",
                  "Convulsions",
                  "Lethargic/unconscious",
                  "Chest indrawing",
                  "Stridor at rest"
                ],
                "reveal_note": "None present on exam."
              }
            ]
          },
          "coach": {
            "eyebrow": "Decision · assessment",
            "title": "What is the best classification now?",
            "body": "Use age-specific fast-breathing cutoffs and danger signs."
          },
          "question": {
            "prompt": "For this 2-year-old, what is the safest interpretation?",
            "options": [
              {
                "text": "Fast breathing pneumonia without danger signs; manage as outpatient and review closely",
                "correct": true
              },
              {
                "text": "No pneumonia because oxygen saturation is above 90%",
                "correct": false
              },
              {
                "text": "Severe pneumonia needing immediate referral because any fever with cough is severe",
                "correct": false
              },
              {
                "text": "Asthma only, so skip IMNCI classification",
                "correct": false
              }
            ],
            "right": "Correct. At age 2 years (12-59 months), RR 48/min is fast breathing, and no chest indrawing/stridor/danger signs are documented. IMNCI supports pneumonia management at HC III with close follow-up.",
            "wrong": "This child meets fast-breathing criteria for age (RR 48/min). Fever plus cough still requires IMNCI classification; oxygen alone does not exclude pneumonia."
          }
        },
        {
          "kind": "decision",
          "chart": {
            "tag": "PLAN",
            "sections": [
              {
                "type": "prescription",
                "title": "Management choice",
                "drug": "Likely non-severe pneumonia package",
                "detail": "Oral antibiotic per guideline, antipyretic, fluids, and feeding support"
              },
              {
                "type": "assessment",
                "title": "Respiratory exam",
                "text": "No chest indrawing, no stridor at rest, alert, taking fluids."
              }
            ]
          },
          "coach": {
            "eyebrow": "Decision · treatment",
            "title": "Choose the most appropriate first plan",
            "body": "Pick the option that matches findings and avoids overtreatment."
          },
          "question": {
            "prompt": "What should you do now?",
            "options": [
              {
                "text": "Start oral pneumonia treatment per IMNCI/UCG, then schedule 2-day follow-up",
                "correct": true
              },
              {
                "text": "Give only cough syrup and vitamins because child is playful",
                "correct": false
              },
              {
                "text": "Start injectable broad-spectrum antibiotics for all cough with fever",
                "correct": false
              },
              {
                "text": "Discharge without counseling because no danger signs are present",
                "correct": false
              }
            ],
            "right": "Correct. Child is stable but meets fast-breathing pneumonia criteria. Guideline-based oral treatment and short follow-up reduce progression risk.",
            "wrong": "RR 48/min at 2 years is not simple cough. Under-treating or skipping follow-up can miss deterioration in the next 24-48 hours."
          }
        },
        {
          "kind": "decision",
          "chart": {
            "tag": "COUNSEL",
            "sections": [
              {
                "type": "dangerScreen",
                "title": "Return immediately if",
                "danger_signs": [
                  "Breathing becomes difficult or very fast",
                  "Child cannot drink/breastfeed",
                  "Chest indrawing appears",
                  "Convulsions or unusual sleepiness"
                ],
                "reveal_note": "Mother repeats warning signs correctly."
              }
            ]
          },
          "coach": {
            "eyebrow": "Decision · caregiver advice",
            "title": "What counseling is essential before discharge?",
            "body": "Choose the message that prevents delayed return."
          },
          "question": {
            "prompt": "Best discharge counseling?",
            "options": [
              {
                "text": "Explain danger signs clearly and set a strict 2-day review even if slightly improved",
                "correct": true
              },
              {
                "text": "Tell caregiver to return only after 1 week if cough remains",
                "correct": false
              },
              {
                "text": "Stop antibiotics once fever reduces on day 1",
                "correct": false
              },
              {
                "text": "No follow-up needed because pulse oximetry is acceptable",
                "correct": false
              }
            ],
            "right": "Correct. For child pneumonia, practical counseling and early review are core IMNCI actions to catch worsening breathing.",
            "wrong": "A child can worsen quickly. Delayed review or incomplete treatment increases risk of severe disease."
          }
        },
        {
          "kind": "story",
          "chart": {
            "tag": "COMPLETE",
            "sections": [
              {
                "type": "assessment",
                "title": "Case outcome",
                "text": "You correctly identified fast-breathing pneumonia and avoided both undertreatment and unnecessary referral.",
                "emphasis": "Age-based RR interpretation changed the decision."
              }
            ]
          },
          "coach": {
            "eyebrow": "Case complete",
            "title": "Key teaching points",
            "body": "Amina's RR 48/min at age 2 years meets fast-breathing criteria. With no chest indrawing, stridor, or general danger signs, outpatient pneumonia management with close review is appropriate under IMNCI and Uganda Clinical Guidelines 2023."
          }
        }
      ]
    },
    {
      "id": "child-diarrhoea-dehydration-001",
      "ready": true,
      "title": "Child with diarrhoea and dehydration assessment",
      "topic": "Child Health",
      "difficulty": "Core",
      "source_type": "Guideline Practice",
      "mode": "Core Practice",
      "level": 1,
      "mins": 7,
      "credit": 0.15,
      "setting": "HC III · OPD",
      "patient": {
        "name": "Okello Brian",
        "id": "PT-CH-240302",
        "age": "18M",
        "sex": "Male"
      },
      "blurb": "An 18-month-old with watery diarrhoea needs rapid dehydration classification and practical ORS planning.",
      "objectives": [
        "Classify dehydration using IMNCI signs before prescribing medicines.",
        "Calculate and start ORS Plan B correctly for a 10 kg child.",
        "Provide zinc and caregiver counseling with a 4-hour reassessment plan."
      ],
      "skills": [
        "Child Health",
        "HC III workflow",
        "Guideline application"
      ],
      "takeaways": [
        "Restlessness, sunken eyes, eager drinking, and slow skin pinch indicate some dehydration.",
        "Plan B for 10 kg child is 75 ml/kg over 4 hours (750 ml total).",
        "Zinc 20 mg daily for 10-14 days should be paired with feeding and return advice."
      ],
      "citations": [
        "Uganda Clinical Guidelines 2023",
        "WHO IMNCI chart booklet"
      ],
      "share": {
        "share_title": "Child with diarrhoea and dehydration assessment",
        "share_prompt": "What would you do first for this child health presentation?",
        "share_summary": "A short HC III clinical reasoning challenge for Karibu Learn.",
        "share_url": "https://learn.karibu.health/c/child-diarrhoea-dehydration-001",
        "discussion_question": "Which finding most changes your next step?"
      },
      "meta": {
        "complexity_score": 0.46,
        "clinical_correctness_score": 0.88,
        "hc3_reality_score": 0.91,
        "learning_value_score": 0.84,
        "source_guideline_ids": [
          "who-imnci-chart-booklet",
          "uganda-clinical-guidelines-2023"
        ],
        "review_status": "needs_review",
        "case_version": "child-diarrhoea-dehydration-001-L1"
      },
      "steps": [
        {
          "kind": "story",
          "chart": {
            "tag": "TRIAGE",
            "sections": [
              {
                "type": "chiefComplaint",
                "title": "Chief complaint",
                "text": "Watery diarrhoea for 2 days",
                "chips": [
                  "Child",
                  "Possible dehydration"
                ]
              },
              {
                "type": "subjective",
                "title": "Caregiver report",
                "text": "Mother says stool is frequent and child drinks quickly but remains thirsty."
              }
            ]
          },
          "coach": {
            "eyebrow": "The visit begins",
            "title": "Brian looks irritable and thirsty",
            "body": "Your first task is dehydration classification, not automatic medicine selection."
          }
        },
        {
          "kind": "decision",
          "chart": {
            "tag": "EXAM",
            "sections": [
              {
                "type": "vitals",
                "title": "Vitals and weight",
                "vitals": [
                  {
                    "label": "TEMP",
                    "value": "37.8 C"
                  },
                  {
                    "label": "HR",
                    "value": "126"
                  },
                  {
                    "label": "RESP",
                    "value": "30/min"
                  },
                  {
                    "label": "WT",
                    "value": "10 kg"
                  }
                ]
              },
              {
                "type": "assessment",
                "title": "Hydration signs",
                "text": "Restless/irritable, sunken eyes, drinks eagerly, skin pinch returns slowly.",
                "emphasis": "No lethargy and not unable to drink."
              }
            ]
          },
          "coach": {
            "eyebrow": "Decision · classification",
            "title": "Which dehydration class fits best?",
            "body": "Use signs exactly as IMNCI describes."
          },
          "question": {
            "prompt": "How should this child be classified?",
            "options": [
              {
                "text": "Some dehydration",
                "correct": true
              },
              {
                "text": "Severe dehydration",
                "correct": false
              },
              {
                "text": "No dehydration",
                "correct": false
              },
              {
                "text": "Dysentery only",
                "correct": false
              }
            ],
            "right": "Correct. These signs support some dehydration, not severe dehydration, because the child is not lethargic and can drink.",
            "wrong": "The sign pattern matches some dehydration. Severe dehydration requires more dangerous findings like lethargy/unconsciousness or inability to drink."
          }
        },
        {
          "kind": "decision",
          "chart": {
            "tag": "PLAN",
            "sections": [
              {
                "type": "prescription",
                "title": "Rehydration plan",
                "drug": "ORS Plan B",
                "detail": "75 ml/kg over 4 hours = 750 ml for 10 kg child"
              },
              {
                "type": "investigations",
                "title": "Required follow-up",
                "orders": [
                  {
                    "name": "4-hour reassessment",
                    "status": "pending",
                    "sub": "Reclassify hydration status"
                  }
                ]
              }
            ]
          },
          "coach": {
            "eyebrow": "Decision · treatment",
            "title": "Choose the correct immediate treatment",
            "body": "Avoid common arithmetic and dosing mistakes."
          },
          "question": {
            "prompt": "What is the best next action?",
            "options": [
              {
                "text": "Start ORS 750 ml over 4 hours and give zinc 20 mg daily for 10-14 days",
                "correct": true
              },
              {
                "text": "Give antidiarrhoeal syrup only, no ORS required",
                "correct": false
              },
              {
                "text": "Give IV fluids immediately to all diarrhoea cases",
                "correct": false
              },
              {
                "text": "Send home first, then start ORS only if still sick tomorrow",
                "correct": false
              }
            ],
            "right": "Correct. For some dehydration at 10 kg, Plan B is 750 ml ORS over 4 hours plus zinc 20 mg daily.",
            "wrong": "This child already has dehydration signs. Delaying ORS or using non-IMNCI shortcuts risks progression to severe dehydration."
          }
        },
        {
          "kind": "decision",
          "chart": {
            "tag": "COUNSEL",
            "sections": [
              {
                "type": "dangerScreen",
                "title": "Return urgently if",
                "danger_signs": [
                  "Unable to drink or breastfeed",
                  "Repeated vomiting",
                  "Blood in stool",
                  "Becomes lethargic or very sleepy"
                ],
                "reveal_note": "Caregiver demonstrates ORS mixing correctly."
              }
            ]
          },
          "coach": {
            "eyebrow": "Decision · discharge safety",
            "title": "What counseling should accompany treatment?",
            "body": "Counseling is part of the intervention, not optional."
          },
          "question": {
            "prompt": "Which counseling package is best?",
            "options": [
              {
                "text": "Teach ORS mixing/use, continue feeding, give zinc daily, and explain danger signs",
                "correct": true
              },
              {
                "text": "Stop feeds until diarrhoea fully resolves",
                "correct": false
              },
              {
                "text": "Avoid ORS at home to prevent overhydration",
                "correct": false
              },
              {
                "text": "Use antibiotics first for all watery diarrhoea",
                "correct": false
              }
            ],
            "right": "Correct. Continued fluids/feeding and clear return precautions prevent deterioration after discharge.",
            "wrong": "Stopping feeds or avoiding home ORS worsens recovery. IMNCI emphasizes caregiver-led oral rehydration and danger-sign recognition."
          }
        },
        {
          "kind": "story",
          "chart": {
            "tag": "COMPLETE",
            "sections": [
              {
                "type": "assessment",
                "title": "Case outcome",
                "text": "You classified some dehydration correctly and initiated Plan B with zinc and caregiver teaching.",
                "emphasis": "Classification before treatment prevented both under- and over-treatment."
              }
            ]
          },
          "coach": {
            "eyebrow": "Case complete",
            "title": "Key teaching points",
            "body": "In IMNCI diarrhoea care, the hydration signs drive treatment. Brian's exam matched some dehydration, so ORS Plan B and zinc with reassessment was the right HC III plan."
          }
        }
      ]
    },
