      "patient": {
        "name": "Okumu Daniel",
        "id": "PT-230411",
        "age": "31M",
        "sex": "Male"
      },
      "blurb": "A confused febrile adult arrives hypotensive and tachypneic. Decide what to do now, what not to delay, and how to hand over safely.",
      "objectives": [
        "Recognize confusion, hypotension, and tachypnea as danger signs requiring immediate referral-level care.",
        "Start pre-referral stabilization and treatment without delaying for full outpatient workup.",
        "Document and communicate referral details clearly to protect continuity of care."
      ],
      "skills": [
        "Malaria",
        "HC III workflow",
        "Guideline application"
      ],
      "takeaways": [
        "Confusion plus BP 86/54 and RR 32/min is not uncomplicated malaria at HC III.",
        "Give pre-referral emergency care first; do not wait for full diagnostics before transfer.",
        "A complete referral note should include danger signs, interventions, and transfer time."
      ],
      "citations": [
        "Uganda Clinical Guidelines 2023"
      ],
      "share": {
        "share_title": "Fever with altered mental status",
