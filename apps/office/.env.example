# Karibu Office (office.karibu.health)
#
# This app deliberately has NO Supabase service-role key. It talks to the
# database with the anon key plus the signed-in user's Clerk session token, so
# it can only reach data through the office_* RPCs. Do not add
# SUPABASE_SECRET_KEY here. See docs/architecture/adr-0002-local-offices.md.

# Same Clerk instance as the EHR (apps/web).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Same Supabase project as the EHR.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origins, used in WhatsApp share links and QR codes.
NEXT_PUBLIC_OFFICE_URL=http://localhost:3010
NEXT_PUBLIC_EHR_URL=http://localhost:3000

# Photo-to-catalog extraction (server only).
OPENAI_API_KEY=
OPENAI_OFFICE_VISION_MODEL=

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
