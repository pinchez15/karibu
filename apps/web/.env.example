# Next.js Environment Variables

# Clerk Authentication (production keys start with pk_live_ / sk_live_)
# Get these from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# Public (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never exposed to browser)
SUPABASE_SECRET_KEY=your-secret-key

# Superadmin bootstrap allowlist (server-only).
# When the superadmins table is empty, ONLY the clinic admin whose Clerk
# primary email matches this value may use the provisioning bootstrap path
# (which seeds the first superadmin row). Leave unset to disable bootstrap.
SUPERADMIN_BOOTSTRAP_EMAIL=

# PostHog Analytics
# Get these from https://us.posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring (optional — errors only logged to console if not set)
# Get DSN from https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Inngest — durable orchestrator for AI notes / draft AI assist (server-only).
# REQUIRED in production or AI notes silently never generate:
#   - INNGEST_EVENT_KEY lets `inngest.send()` deliver events to Inngest Cloud.
#   - INNGEST_SIGNING_KEY lets Inngest invoke the deployed /api/inngest endpoint.
# You must ALSO register the deployed /api/inngest URL in the Inngest dashboard.
# Locally, `npx inngest-cli@latest dev` discovers functions and these can be unset.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI — used by the Inngest AI functions (Whisper dictation, note review,
# HMIS code suggestions). The review functions throw "OPENAI_API_KEY is not set"
# if missing, so AI notes will not generate without it.
OPENAI_API_KEY=
# Optional model overrides (default: gpt-4o-mini)
OPENAI_STRUCTURING_MODEL=
OPENAI_MEDICAL_MODEL=
