{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.karibu.health/learn/case.schema.json",
  "title": "Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "level", "simulatedPatient", "decisionNodes", "citations"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "enum": ["introductory", "intermediate", "advanced"] },
    "learningObjectives": { "type": "array", "items": { "type": "string" } },
    "simulatedPatient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "sex", "ageLabel"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "sex": { "type": "string", "enum": ["female", "male", "unknown"] },
        "ageLabel": { "type": "string", "minLength": 1 },
        "chartSummary": { "type": "string" }
      }
    },
    "decisionNodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "decision-node.schema.json" }
    },
    "citations": {
      "type": "array",
      "items": { "$ref": "citation.schema.json" }
    }
  }
}
