          "kind": "story",
          "chart": {
            "tag": "COMPLETE",
            "sections": [
              {
                "type": "assessment",
                "title": "Case outcome",
                "text": "Recognized severe febrile danger signs and initiated urgent pre-referral care.",
                "emphasis": "Outpatient oral malaria treatment alone was unsafe for this presentation."
