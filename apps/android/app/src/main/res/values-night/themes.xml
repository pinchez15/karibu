<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Night variant of the platform theme. Uses the non-Light Material parent so
      the system bar icons render light, the window background is dark while
      Compose initializes, and any platform-rendered dialog/menu inherits a dark
      base. Compose colors still come from KaribuHealthTheme's DarkColorScheme.
    -->
    <style name="Theme.KaribuHealth" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dark_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
